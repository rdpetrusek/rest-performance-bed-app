# Builds the ReST Bed dashboard: the Angular app embedded into the Go server
# binary. See compose.yaml for how this is run.
#
# The host running this container needs network access to the bed's local
# API. Simplest setup: join the host to the bed's own Wi-Fi AP (SSID
# "ReST-<id>", open/no password) and leave the bed in that default "direct"
# mode permanently - see docs/protocol.md for why "indirect" (joining your
# home Wi-Fi) is unreliable on this hardware.

FROM node:22-slim AS ui
WORKDIR /src/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npx ng build

FROM golang:1.26 AS server
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY --from=ui /src/ui/dist/ui/browser/ internal/web/static/app/
ENV CGO_ENABLED=0
RUN go build -o /out/server ./cmd/server

FROM gcr.io/distroless/static-debian12
COPY --from=server /out/server /server
VOLUME ["/data"]
EXPOSE 8000
ENTRYPOINT ["/server"]
